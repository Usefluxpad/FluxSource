// FluxPad — persistent launch records.
// On-chain state is the source of truth for graduation and pool verification;
// this database stores FluxPad's own observations and user launch intents.

generator client {
  provider = "prisma-client-js"
}

// Provider note: production uses "postgresql" (see .env.example). Local
// development in this environment has no PostgreSQL server available, so the
// provider is set to "sqlite" (documented in docs/VERIFICATION.md). All model
// definitions are identical across providers.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LaunchRoute {
  PUMP_PUMPSWAP
  LAUNCHLAB_CPMM
}

enum LaunchStatus {
  // Intent recorded, transaction not yet built or submitted.
  PREPARATION
  // Transaction submitted to RPC, confirmation pending.
  SUBMITTED
  // Transaction confirmed on-chain, mint verified.
  CONFIRMED
  // Confirmed and actively trading on the bonding curve.
  CURVE_TRADING
  // Graduation threshold crossed (observed on-chain).
  GRADUATION_DETECTED
  // Destination pool verified on-chain.
  POOL_VERIFIED
  // Transaction failed or was rejected; safe to retry.
  FAILED
  // Terminal unknown: submitted but confirmation could not be determined.
  UNRESOLVED
}

model Launch {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  creatorWallet String
  route         LaunchRoute
  status        LaunchStatus @default(PREPARATION)

  // Token metadata
  name          String
  symbol        String
  description   String?
  metadataUri   String?
  imageUrl      String?
  network       String // "devnet" | "mainnet-beta"

  // On-chain identity (null until confirmed)
  mintAddress   String? @unique
  signature     String?
  slot          Int?
  blockTime     DateTime?
  // Idempotency key derived from client session + form data to prevent
  // accidental duplicate submissions.
  idempotencyKey String   @unique

  // Destination pool (null until verified on-chain)
  poolAddress   String?
  poolVerifiedAt DateTime?

  // Protocol-specific observed state (JSON snapshot from on-chain reads)
  curveState    Json?
  lastError     String?

  timeline      LaunchEvent[]

  @@index([creatorWallet, createdAt])
  @@index([status])
  @@index([route])
}

// Append-only lifecycle audit log. Idempotent via (launchId, kind, txOrSlotKey).
model LaunchEvent {
  id        String   @id @default(cuid())
  launchId  String
  launch    Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  kind      String // e.g. "submitted", "confirmed", "graduation_detected", "pool_verified", "failed"
  detail    Json?
  // dedupe key: e.g. signature + kind, or slot + kind
  dedupeKey String

  @@unique([launchId, dedupeKey])
  @@index([launchId])
}

// Audit log for metadata/artwork uploads (no credentials, no private data).
model UploadAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  uploader  String
  fileName  String
  sizeBytes Int
  mime      String
  cid       String?
  status    String // "ok" | "rejected" | "error"
  reason    String?
}

// =============================================================================
// Official $FLUX treasury dashboard (read-only observability).
//
// On-chain state is the source of truth: every row below is derived from a
// verified, confirmed transaction fetched over RPC and is idempotently
// upserted (dedupe via (signature, entryKey)) so re-indexing never duplicates.
// Public addresses and non-secret configuration only — no keys, ever.
// =============================================================================

// One verified on-chain activity entry relevant to a configured treasury wallet.
model RelayOfficialActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Transaction identity + dedupe. entryKey distinguishes multiple relevant
  // entries inside one transaction (e.g. two transfers, or a swap + a burn).
  signature String
  entryKey  String
  @@unique([signature, entryKey])

  // Classification: "fee_collect" | "transfer" | "swap" | "burn" | "other"
  type    String
  status  String // "confirmed" | "failed" — only confirmed rows are aggregated

  slot     Int?
  blockTime DateTime?
  // Which configured treasury wallet(s) this entry involves (role id: W1..W4).
  walletRole String?

  sender     String?
  recipient  String?

  // Verified amounts. Stored as strings (u64-safe across providers).
  inputAmount  String?
  inputAsset   String? // mint address or "SOL"
  inputDecimals Int?
  outputAmount String?
  outputAsset  String?
  outputDecimals Int?

  // For burns: the SPL mint actually burned + burn-instruction verification.
  burnMint String?
  burnVerified Boolean @default(false)

  // Owning program of the classified instruction (pump / pump-amm / system /
  // spl-token / token-2022) — recorded, never guessed.
  programId String?
  network   String
  detail    Json?

  // Reconciliation: set once the signature is re-verified against the node.
  onChainVerified Boolean @default(false)
  verifiedAt      DateTime?

  @@index([type, blockTime])
  @@index([signature])
  @@index([walletRole, blockTime])
  @@index([sender])
  @@index([recipient])
}

// Per-scan indexing/reconciliation state (per configured wallet or global).
model RelayOfficialIndexState {
  id  String @id @default(cuid())
  key String @unique // wallet address or "reconcile"

  lastRunAt    DateTime?
  lastStatus   String? // "ok" | "error"
  lastError    String?
  lastSignature String?
  // Last successful full reconciliation (DB rows re-checked against chain).
  lastReconciledAt DateTime?
}

