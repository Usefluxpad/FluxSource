# FluxPad environment configuration (DotPad and RelayPad variable names are
# retained as legacy fallbacks — the FLUXPAD_* names win when several are set)
# Copy to .env.local and fill in values. NEVER commit real secrets.
# ==============================================================================
#
# PRODUCTION DEPLOYMENT (non-Vercel hosting):
#   - Node.js >= 20 (package.json engines).
#   - Install with: npm install --legacy-peer-deps
#   - Build with:   npm run build      (next build)
#   - Start with:   npm run start      (next start)
#   - Build must NOT run while `next dev` is running on the same directory:
#     a concurrent build corrupts .next (documented in docs/VERIFICATION.md).
#   - Database (choose one):
#     a) PostgreSQL (recommended): point DATABASE_URL at the Postgres
#        connection string, switch the provider in prisma/schema.prisma to
#        "postgresql" (one word), run `prisma generate` +
#        `prisma migrate deploy`, then build. Models are identical across
#        providers; see prisma/postgres/schema.prisma and its README.
#     b) SQLite: keep provider "sqlite" and set DATABASE_URL to a file: URL
#        on a PERSISTENT disk (e.g. file:/var/data/fluxpad/prod.db), then
#        run `prisma migrate deploy`. Ephemeral disks lose launch records.
#   - Run migrations in CI or before start: npm run prisma:migrate
#     (prisma migrate deploy). The prisma CLI is a devDependency, so run
#     migrations before pruning devDependencies.
# ==============================================================================

# ------------------------------------------------------------------------------
# Solana network & RPC
# ------------------------------------------------------------------------------
# Priority: NEXT_PUBLIC_FLUXPAD_NETWORK (current) -> NEXT_PUBLIC_DOTPAD_NETWORK
# (legacy) -> NEXT_PUBLIC_RELAYPAD_NETWORK (oldest legacy fallback).
#   "devnet" | "mainnet-beta" - controls which network the client connects to and
#   which program IDs are used. The FLUXPAD name wins when several are set.
#   NOTE: NEXT_PUBLIC_* values are inlined at BUILD time - migrating hosting to
#   the new name requires a production rebuild.
NEXT_PUBLIC_FLUXPAD_NETWORK=devnet
NEXT_PUBLIC_DOTPAD_NETWORK=
NEXT_PUBLIC_RELAYPAD_NETWORK=

# Public RPC endpoint used by the browser client. Use your own provider for
# production (Helius, QuickNode, Triton, etc.). Leave empty to use the
# Solana public cluster endpoint (heavily rate-limited).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-side RPC endpoint used for on-chain reconciliation / verification.
# Should be a paid, rate-limit-friendly endpoint. Defaults to the public one.
SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# Browser RPC (wallet connection + launch flow — client-side)
# ------------------------------------------------------------------------------
# Recommended: FluxPad's built-in server-side proxy, "/api/rpc". It forwards
# browser JSON-RPC to ALCHEMY_SOLANA_RPC_URL server-side with a strict method
# allowlist — the API key never reaches the browser, and signing stays in the
# wallet. Any dedicated browser-safe RPC URL can also be used here.
# SECURITY: never put a credentialed URL in a NEXT_PUBLIC_* variable —
# NEXT_PUBLIC_* values are inlined into the browser bundle.
NEXT_PUBLIC_SOLANA_RPC_URL=/api/rpc

# ------------------------------------------------------------------------------
# Alchemy — dedicated Solana RPC provider (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Precedence for server-side reads (discovery, reconcile, tx confirmation)
# and browser proxying via /api/rpc:
#   1. ALCHEMY_SOLANA_RPC_URL (dedicated, rate-limit friendly)
#   2. SOLANA_RPC_URL (custom provider)
#   3. Solana public cluster endpoint (heavily rate-limited)
# The WebSocket URL (ALCHEMY_SOLANA_WS_URL) is reserved for real-time features;
# the app runs without it. ALCHEMY_API_KEY is accepted for gateway URLs that
# need it. Leave all empty to use the public endpoint.
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WS_URL=

# ------------------------------------------------------------------------------
# Database (launch registry persistence)
# ------------------------------------------------------------------------------
# SQLite by default (file: URL relative to the prisma folder). The launch
# registry stores FluxPad's observations only; on-chain state remains the
# source of truth for graduation / pool status; the DB only stores what
# FluxPad observed.
DATABASE_URL="file:./dev.db"
# Optional: PostgreSQL (see the deployment notes at the top). When set, switch
# the provider in prisma/schema.prisma to "postgresql" and run migrations.
POSTGRES_DATABASE_URL=

# ------------------------------------------------------------------------------
# Pinata — IPFS uploads for token artwork (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# FluxPad uploads artwork and metadata JSON to IPFS through Pinata.
# Create a free account at pinata.cloud, generate a JWT, and paste it here.
# Leave empty in development to run without upload capability — the API will
# return a clear configuration error instead of accepting uploads.
PINATA_JWT=
# Optional: dedicated gateway host used to display uploaded assets.
PINATA_GATEWAY=ipfs.io
# NOTE: the artwork upload cap is fixed at 10 MB in code
# (src/lib/metadata.ts, constraints.maxBytes) and is NOT env-configurable.

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
# Optional display name override; the site metadata lives in
# src/app/layout.tsx.
NEXT_PUBLIC_APP_NAME=FluxPad
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional (Vercel-only): VERCEL_PROJECT_PRODUCTION_URL is injected by Vercel
# and only refines the SEO/metadata origin there. On any other host it stays
# unset and NEXT_PUBLIC_APP_URL is used instead. Example: fluxpad.example.com
# VERCEL_PROJECT_PRODUCTION_URL=

# ------------------------------------------------------------------------------
# Official $FLUX treasury dashboard (SERVER-SIDE ONLY — public data)
# ------------------------------------------------------------------------------
# Public addresses and non-secret configuration for the read-only /treasury
# dashboard. All values are PLACEHOLDERS until the owner finalizes them; unset
# values render honest "configuration needed" states on the dashboard.
# NEVER put private keys, seed phrases, or signing credentials in this file or
# any NEXT_PUBLIC_* variable — public addresses only.
# See docs/RELAY_OFFICIAL_TOKEN_BUYBACK_IMPLEMENTATION_PLAN.md (historical).
FLUXPAD_OFFICIAL_ENABLED=
# Network override; falls back to NEXT_PUBLIC_FLUXPAD_NETWORK, then the
# DOTPAD/RELAYPAD legacy names when unset.
FLUXPAD_OFFICIAL_NETWORK=
# W1 — official $FLUX creator-fee receiver (permanent fee recipient).
FLUXPAD_OFFICIAL_CREATOR_WALLET=
# W2 — dedicated buyback treasury.
FLUXPAD_OFFICIAL_BUYBACK_TREASURY=
# W3 — operations & reserve treasury.
FLUXPAD_OFFICIAL_OPS_TREASURY=
# W4 — separate development wallet (transparency listing only).
FLUXPAD_OFFICIAL_DEV_WALLET=
# Official $FLUX mint address (after launch; verified on-chain).
# Deliberately left empty until a VERIFIED $FLUX mint exists — the DotPad-era
# DOTPAD_OFFICIAL_MINT and legacy RELAY_OFFICIAL_MINT values are NEVER reused
# as the $FLUX mint, and no placeholder address is substituted.
FLUXPAD_OFFICIAL_MINT=

# ---- Legacy DotPad names (FALLBACKS — FLUXPAD_* wins when both are set) ----
# Wallets, network, and the enabled switch fall back to these when the
# FLUXPAD_* names are unset. NOTE: the official $FLUX MINT has NO fallback —
# it is read ONLY from FLUXPAD_OFFICIAL_MINT above; the DotPad-era
# DOTPAD_OFFICIAL_MINT value is never reused as the $FLUX mint, so no legacy
# mint entry exists in this block.
DOTPAD_OFFICIAL_ENABLED=
DOTPAD_OFFICIAL_NETWORK=
DOTPAD_OFFICIAL_CREATOR_WALLET=
DOTPAD_OFFICIAL_BUYBACK_TREASURY=
DOTPAD_OFFICIAL_OPS_TREASURY=
DOTPAD_OFFICIAL_DEV_WALLET=

# ---- Oldest legacy RelayPad names (FALLBACKS — used only when neither the
# FLUXPAD_* nor the DOTPAD_* names are set) ----
RELAY_OFFICIAL_ENABLED=
RELAY_OFFICIAL_NETWORK=
RELAY_OFFICIAL_CREATOR_WALLET=
RELAY_OFFICIAL_BUYBACK_TREASURY=
RELAY_OFFICIAL_OPS_TREASURY=
RELAY_OFFICIAL_DEV_WALLET=

# ------------------------------------------------------------------------------
# Shared RPC gateway (server-side Solana request management)
# ------------------------------------------------------------------------------
# All server-side Solana JSON-RPC (live trending poller, discovery, token
# market reads, treasury, and the browser /api/rpc proxy) flows through one
# gateway: token-bucket throttling, bounded concurrency, duplicate coalescing,
# short-TTL read caching, 429 backoff honoring Retry-After with jitter, and a
# circuit breaker. Defaults are tuned for a single Alchemy key; raise them
# only when the provider plan allows more throughput.
# RPC_GATEWAY_RATE_RPS=8
# RPC_GATEWAY_BURST=16
# RPC_GATEWAY_CONCURRENCY=6
# RPC_GATEWAY_OPEN_BASE_MS=15000

# ------------------------------------------------------------------------------
# PumpPortal live data (optional — keyless tier streams token creations and
# migrations; per-token trade streaming requires an API key funded with at
# least 0.02 SOL, and FluxPad otherwise sources trades via on-chain RPC)
# ------------------------------------------------------------------------------
PUMPPORTAL_API_KEY=
PUMP_LIVE_ENABLED=true
PUMP_LIVE_MAX_TOKEN_SUBS=300
PUMPPORTAL_TRADE_POLL_MS=12000

